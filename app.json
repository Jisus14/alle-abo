{
  "expo": {
    "name": "Alle Abo",
    "slug": "alle-abo",
    "version": "1.0.0",
    "scheme": "alleabo",
    "android": {
      "package": "at.ac.hcw.alleabo",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "ios": {
      "bundleIdentifier": "at.ac.hcw.alleabo"
    },
    "plugins": [
      [
        "expo-calendar",
        {
          "calendarPermission": "Alle Abo needs calendar access to inject and update subscription deadlines."
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "b76a1805-1b9a-4f46-b052-75ed80737d44"
      }
    }
  }
}
